@using Basilisk.Presentation.Web.ViewModels.Customer
@model CustomerIndexViewModel
@{
    ViewData["Title"] = "Customer Index";
}

@section breadCrumbs {
    <span>Customer Index</span>
}

<section class="grid-container customer-index">
    <form asp-action="Index" method="get" class="filter">
        <input type="text" name="companyName" placeholder="Company Name..." value="@ViewBag.SearchName" />
        <input type="text" name="contactPerson" placeholder="Contact Name..." value="@ViewBag.SearchContact" />
        <button class="blue-button" type="submit">Search</button>
        <a asp-action="Index" class="blue-button">Reset</a>
    </form>
    <a asp-action="Insert" class="blue-button create-button">Insert New Customer</a>
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Company Name</th>
                <th>Contact Person</th>
                <th>Address</th>
                <th>City</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int no = 1;
            }
            
            @foreach (var customer in Model.Customers)
            {
                <tr>
                    <td>@no</td>
                    <td>@customer.CompanyName</td>
                    <td>@customer.ContactPerson</td>
                    <td>@customer.Address</td>
                    <td>@customer.City</td>
                    <td>@customer.Phone</td>
                    <td>@customer.Email</td>
                    <td>
                        <div class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="blue-button">
                                <i class="fa-solid fa-pen-to-square"></i></a>
                                
                                <form asp-action="Delete" asp-controller="Customer" method="post" style="display:inline"
                                      onsubmit="return confirm('Are you sure you want to delete this customer?');">

                                    <input type="hidden" name="id" value="@customer.Id" />
                                    <button type="submit" class="blue-button"><i class="fa-solid fa-trash-can"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    no++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="8">
                        <div class="pagination">
                            <div>Page @Model.PageNumber of @Model.TotalPages</div>
                            <div>
                                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                                {
                                    <a asp-action="Index"
                                       asp-route-companyName="@ViewBag.SearchName"
                                       asp-route-contactPerson="@ViewBag.SearchContact"
                                       asp-route-page="@pageNumber" class="number">@pageNumber</a>
                                    
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </section>