@model CategoryIndexViewModel
@{
    ViewData[index: "Title"] = "Category Index";
}

@section breadCrumbs {
    <span>Category Index</span>
}

<section class="grid-container category-index">
    <form asp-action="Index" method="get" class="filter">
        <input type="text" name="searchName" placeholder="Category Name..." value="@ViewBag.SearchName" />
        <button class="blue-button" type="submit">Search</button>
        <a asp-action="Index" class="blue-button">Reset</a>
    </form>
    <a asp-action="Insert" class="blue-button create-button">Insert New Category</a>
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Name</th>
                <th>Description</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int no = 1;
            }
            
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@no</td>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@category.Id" class="blue-button"><i
                            class="fa-solid fa-pen-to-square"></i></a>
                            <form asp-action="Delete" asp-controller="Category" method="post" style="display:inline"
                                  onsubmit="return confirm('Yakin ingin menghapus kategori ini?');">

                                <input type="hidden" name="id" value="@category.Id" />
                                <button type="submit" class="blue-button"><i class="fa-solid fa-trash-can"></i></button>
                            </form>
                        </td>
                    </tr>

                    no++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4">
                        <div class="pagination">
                            <div>Page @Model.PageNumber of @Model.TotalPages</div>
                            <div>
                                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                                {
                                    <a asp-action="Index" asp-route-searchName="@ViewBag.SearchName"
                                       asp-route-page="@pageNumber" class="number">@pageNumber</a>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </section>
