@model Basilisk.Presentation.Web.ViewModels.Supplier.SupplierIndexViewModel
@{
    ViewData["Title"] = "Supplier Index";
}

@section breadCrumbs {
    <span>Supplier Index</span>
}

<section class="grid-container supplier-index">
    <form asp-action="Index" method="get" class="filter">
        <input type="text" name="searchCompanyName" placeholder="Company Name..." value="@ViewBag.SearchCompanyName" />
        <input type="text" name="searchContactPerson" placeholder="Contact Person..."
               value="@ViewBag.SearchContactPerson" />
        <input type="text" name="searchJobTitle" placeholder="Job Title..." value="@ViewBag.SearchJobTitle" />
        <button class="blue-button" type="submit">Search</button>
        <a asp-action="Index" class="blue-button">Reset</a>
    </form>
    <a asp-action="Insert" class="blue-button create-button">Insert New Supplier</a>
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Company Name</th>
                <th>Contact Person</th>
                <th>Job Title</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int no = 1;
            }
            
            @foreach (var supplier in Model.Suppliers)
            {
                <tr>
                    <td>@no</td>
                    <td>@supplier.CompanyName</td>
                    <td>@supplier.ContactPerson</td>
                    <td>@supplier.JobTitle</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="blue-button">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <form asp-action="Delete" asp-controller="Supplier" method="post" style="display:inline"
                              onsubmit="return confirm('Yakin ingin menghapus supplier ini?');">

                            <input type="hidden" name="id" value="@supplier.Id" />
                            <button type="submit" class="blue-button"><i class="fa-solid fa-trash-can"></i></button>
                        </form>
                    </td>
                </tr>

                no++;
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5">
                    <div class="pagination">
                        <div>Page @Model.PageNumber of @Model.TotalPages</div>
                    
                        <div>
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <a asp-action="Index" asp-route-searchCompanyName="@ViewBag.SearchCompanyName"
                                   asp-route-searchContactPerson="@ViewBag.SearchContactPerson"
                                   asp-route-searchJobTitle="@ViewBag.SearchJobTitle" asp-route-page="@pageNumber"
                                   class="number">@pageNumber</a>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        </tfoot>
    </table>
</section>
