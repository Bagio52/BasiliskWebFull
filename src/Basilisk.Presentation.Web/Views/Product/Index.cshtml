@model ProductIndexViewModel

@{
    ViewData["Title"] = "Product Index";
}

@section breadCrumbs {
    <span>Product Index</span>
}

<section class="product-catalog">
    <div class="product-catalog-header">
        <div>
            <span class="product-catalog-eyebrow">Inventory</span>
            <h1>Products</h1>
            <p>Browse and manage your product catalog.</p>
        </div>
        <a class="blue-button product-create-button" asp-action="Insert" asp-controller="Product">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Add product</span>
        </a>
    </div>

    <form method="get" class="product-filter" asp-action="Index">
        <label class="product-filter-field">
            <span>Product name</span>
            <input type="text" name="name" placeholder="Search products..." value="@Model.Name">
        </label>
        <label class="product-filter-field">
            <span>Category</span>
            <select name="categoryId">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value" selected="@category.Selected">@category.Text</option>
                }
            </select>
        </label>
        <label class="product-filter-field">
            <span>Supplier</span>
            <select name="supplierId">
                <option value="">All suppliers</option>
                @foreach (var supplier in Model.Suppliers)
                {
                    <option value="@supplier.Value" selected="@supplier.Selected">@supplier.Text</option>
                }
            </select>
        </label>
        <div class="product-filter-actions">
            <button class="blue-button" type="submit">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span>Search</span>
            </button>
            <a asp-action="Index" class="product-reset-button">Reset filters</a>
        </div>
    </form>

    <div class="product-results-heading">
        <span>Matching products</span>
        <span class="product-count">@Model.Products.Count</span>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="product-empty-state">
            <span class="product-empty-icon"><i class="fa-solid fa-box-open" aria-hidden="true"></i></span>
            <strong>No products found</strong>
            <span>Try adjusting your filters or add a new product to the catalog.</span>
        </div>
    }
    else
    {
        <div class="product-card-grid">
            @foreach (var product in Model.Products)
            {
                <article class="product-card">
                    <div class="product-card-image">
                        @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="product-image-placeholder">
                                <i class="fa-regular fa-image" aria-hidden="true"></i>
                            </span>
                        }
                        <span class="product-stock-badge @(product.Stock > 0 ? "in-stock" : "out-of-stock")">
                            @(product.Stock > 0 ? "In stock" : "Out of stock")
                        </span>
                    </div>
                    <div class="product-card-content">
                        <div class="product-card-taxonomy">
                            <span>@(product.CategoryName ?? "Uncategorized")</span>
                            <span class="product-card-supplier">@(product.SupplierName ?? "No supplier")</span>
                        </div>
                        <h2 class="product-card-name">@product.Name</h2>
                        <div class="product-card-price">@product.Price.ToString("C")</div>
                        <div class="product-card-stock">
                            <span>Available stock</span>
                            <strong>@product.Stock</strong>
                        </div>
                        <div class="product-card-actions">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="blue-button">
                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                <span>Edit</span>
                            </a>
                            <form asp-action="Delete" asp-controller="Product" method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <input type="hidden" name="id" value="@product.Id" />
                                <button type="submit" class="product-delete-button">
                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                    <span>Delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
