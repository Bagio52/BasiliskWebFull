@model ProductIndexViewModel
@{
    ViewData[index: "Title"] = "Product Index";
}

@section breadCrumbs {
    <Span>Product Index</Span>
}

<section>
    
    <div class="grid-tiles product-index">
        <form method="get" class="filter" action="">
            <input type="text" name="name" placeholder="Product Name...">
            <select name="categoryId">
                <option value="">No Specific Category</option>

                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value" selected="@category.Selected">
                        @category.Text
                    </option>
                }
            </select>
            <select name="supplierId">
                <option th:value="null">No Specific Supplier</option>
                <option value="1">Indofood</option>
                <option value="2">Samsung</option>
                <option value="3">Electronic City</option>
            </select>
            <button class="blue-button" type="submit">Search</button>
        </form>
        <a class="blue-button create-button" asp-action="Insert" asp-controller="Product">Insert New Product</a>
        <div class="tiles-container">
            @foreach (var product in Model.Products)
            {
                <div class="tile">
                    <div class="image-container">
                        <img src="@product.ImagePath" alt="@product.Name" />
                    </div>
                    <div class="tile-content">
                        <h3>@product.Name</h3>
                        <p>Category: @product.Name</p>
                        <p>Supplier: @product.Name</p>
                        <p>Price: @product.Price.ToString("C")</p>
                        <p>Stock: @product.Stock</p>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="blue-button">Edit</a>
                        <form asp-action="Delete" asp-controller="Product" method="post" style="display:inline"
                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                            <input type="hidden" name="id" value="@product.Id" />
                            <button type="submit" class="blue-button">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
        <div class="pagination">
            <div>page 1 of 1</div>
            <div>
                <a href="javascript:;" class="number">1</a>
            </div>
        </div>
    </div>
</section>